# Django Secret Key (generate a secure random string in production)
SECRET_KEY=django-insecure-replace-this-with-a-secure-secret-key-in-production

# Debug Mode (True for development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DATABASE_NAME=expense_tracker_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Set to True if testing locally without PostgreSQL running yet
USE_SQLITE_FALLBACK=False

# CORS Allowed Origins (comma-separated list of frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL (used to generate email verification links)
FRONTEND_URL=http://localhost:5173

# Email SMTP Configuration (Use environment variables for all credentials)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
DEFAULT_FROM_EMAIL=Expense Tracker <your_email@gmail.com>
EMAIL_TIMEOUT=10
EMAIL_VERIFICATION_TIMEOUT_HOURS=24

